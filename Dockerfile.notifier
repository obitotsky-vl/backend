FROM golang:1.22-alpine AS builder
WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /notifier ./cmd/notifier

FROM alpine:3.19
RUN apk add --no-cache ca-certificates tzdata wget
COPY --from=builder /notifier /usr/local/bin/notifier
COPY config.example.json /etc/booking/config.json
EXPOSE 8081
HEALTHCHECK --interval=10s --timeout=3s CMD wget -qO- http://localhost:8081/health || exit 1
ENTRYPOINT ["/usr/local/bin/notifier"]